generator client {
  provider = "prisma-client"
  output   = "../../generated/qim"
}

datasource db {
  provider = "postgresql"
}

/// Bảng lưu thông tin các job đang giữ
model JobTagHold {
  jobOrderNo String    @id @map("job_order_no") @db.VarChar(12) /// Job no
  documentNo String    @map("document_no") @db.VarChar(20)      /// Mã phiếu ghi nhận
  holdAt     DateTime @map("hold_at")                           /// Thời gian bắt đầu giữ
  releaseAt  DateTime? @map("release_at")                       /// Thời gian hết giữ
  status     Boolean                                            /// 1: Hold | 0: Release

  @@map("a5_job_tag_hold")
}
